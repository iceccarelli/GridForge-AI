+    """
+    MAX_COMPUTE = "max_compute"          # most racks; capex is secondary
+    MIN_COST_PER_RACK = "min_cost"       # cheapest capacity
+    FASTEST_TO_POWER = "fastest"         # earliest full energisation
+
