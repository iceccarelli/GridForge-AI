-# --------------------------------------------------------------- rebuild ----
-# The situation this exists for: the patches were applied to the working tree
-# but never committed, so every line of work shows as untracked and the
-# repository's history records none of it. Committing that as one lump would
-# throw away the only thing that makes the history worth having — the ability
-# to see, and revert, one change at a time.
-#
-# So it is rebuilt from the patch files, which are themselves in the repository.
-# 0001 and 0002 are folded into 0002-baseline-*.patch; the chain starts there.
-cmd_rebuild() {
-  local chain=() p
-  [ -f 0002-baseline-patches-001-and-002.patch ] \
-    || die "0002-baseline-patches-001-and-002.patch is not here. The chain starts with it."
-  chain+=(0002-baseline-patches-001-and-002.patch)
-  for p in $(ls 00[0-9][0-9]-*.patch 2>/dev/null | sort); do
-    case "$p" in 0001-*|0002-baseline-*) continue ;; esac
-    chain+=("$p")
-  done
-  [ "${#chain[@]}" -gt 1 ] || die "found no patches after the baseline."
-
-  head_ "the chain"
-  for p in "${chain[@]}"; do say "  $p"; done
