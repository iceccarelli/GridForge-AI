-
-# ---------------------------------------------------------------- verify ----
-cmd_verify() {
-  head_ "install"
-  python -m pip install -q -e '.[dev]' 2>&1 | grep -vE 'WARNING: Running pip|virtual environment' || true
-  python -m pip install -q cryptography 2>&1 | grep -vE 'WARNING: Running pip|virtual environment' || true
-
-  head_ "tests"
-  python -m pytest tests/ -q --no-cov || return 1
-
-  head_ "lint"
-  ruff check src/assurance tests/ || return 1
-
-  head_ "types"
-  mypy src/assurance 2>&1 | tail -5 || true
-
-  head_ "surface"
-  python -m assurance | sed 's/^/  /'
-  ok "verified"
-  return 0
-}
-
-# ------------------------------------------------------------------ ship ----
-cmd_ship() {
-  _sync_self
-  [ "$(git rev-parse --abbrev-ref HEAD)" = "$MAIN" ] || _blocked "ship only pushes $MAIN."
-  [ -z "$(git status --porcelain --untracked-files=no)" ] || _blocked "ship needs a clean tree."
