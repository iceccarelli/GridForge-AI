-  git push --no-follow-tags origin "$MAIN"
-  ok "$(git log --oneline -1)"
-}
-
-# ---------------------------------------------------------------- rescue ----
-# One command from any state to "one branch, tests green, pushed".
-#
-# It exists because the recovery was four commands that had to be run in order,
-# each of which refused for a different reason if the one before had not finished
-# — and the failure that started it all was a stale copy of THIS script. A repair
-# procedure you have to already be healthy to run is not a repair procedure.
-cmd_rescue() {
-  head_ "what this will do"
-  say "  1. refuse if any local branch holds commits that exist nowhere else"
-  say "  2. tar the working tree up"
-  say "  3. reset $MAIN to origin/$MAIN and replay the patch chain onto it"
-  say "  4. delete every other branch and tag, local and remote (gh-pages kept)"
-  say "  5. install, test, lint, type-check"
-  say "  6. push $MAIN"
-  say ""
-  say "  Untracked files that are not patches are discarded in step 3. They are in"
-  say "  the tarball. Nothing that is committed anywhere is lost at any point."
-
-  head_ "checking for work that exists only on another branch"
-  _refuse_to_lose_work
-  ok "every local branch is reachable from $MAIN — nothing to lose"
-
-  cmd_rebuild
-  cmd_normalise --yes
-  cmd_ship
-
-  head_ "done"
-  ok "one branch, $(git rev-list --count HEAD) commit(s), pushed"
-  say "  the tarball in $(cd .. && pwd) can go when you are happy."
-}
