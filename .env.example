# ============================================================================
# GridForge AI — environment configuration
# Copy to .env.local for development. Add the same keys in Vercel → Settings →
# Environment Variables for production. None are required to build or deploy;
# without them, leads are logged server-side instead of emailed.
# ============================================================================

# --- Lead capture (pick ONE path) ---------------------------------------------

# Simplest: Formspree. Create a form at https://formspree.io and paste its ID
# (the part after /f/). Optional: /api/audit forwards a copy here server-side;
# it no longer bypasses Supabase/scoring. Or use FORMSPREE_FORWARD_ID instead.
# NEXT_PUBLIC_FORMSPREE_ID=xxxxxxxx

# Or: server-side email via Resend (used by /api/audit when Formspree is unset).
# Get a key at https://resend.com
# RESEND_API_KEY=re_xxx
# LEAD_TO_EMAIL=power@gridforge.ai
# LEAD_FROM_EMAIL=GridForge AI <onboarding@resend.dev>

# --- Optional analytics -------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gridforge.ai

# --- Lead persistence: Supabase (optional) ------------------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then add these. /api/audit writes leads with the service-role key
# (server-only — never expose it client-side / never prefix NEXT_PUBLIC_).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Hot-lead notification (optional) -----------------------------------------
# Slack incoming webhook — pinged ONLY for hot-tier leads, so the channel stays
# signal. https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Founder admin dashboard (/admin) -----------------------------------------
# Password gate for the internal lead pipeline at /admin. Required to view leads.
# Reads use SUPABASE_SERVICE_ROLE_KEY above. Pick a long random string.
# ADMIN_PASSWORD=change-me-to-something-long

# --- Founder admin dashboard (/admin) -----------------------------------------
# Password gate for the internal lead pipeline at /admin. Required to view leads.
# Reads use SUPABASE_SERVICE_ROLE_KEY above. Pick a long random string.
# ADMIN_PASSWORD=change-me-to-something-long

# --- Capacity engine (gridforge) --------------------------------------------
# The Python envelope engine that backs /qualify and the paid deliverables.
# Run it with:  python3 -m gridforge serve --port 8080
# or:           docker build -t gridforge . && docker run -p 8080:8080 gridforge
# Without GRIDFORGE_API_URL the qualifier captures the enquiry and says plainly
# that no result was produced — it never invents a number.
# GRIDFORGE_API_URL=https://engine.internal.example.com
# Only needed for the paid endpoints (/v1/screen, /v1/study, /v1/portfolio).
# Set the same value as GRIDFORGE_API_KEYS on the engine.
# GRIDFORGE_API_KEY=
