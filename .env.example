# ============================================================================
# GridForge AI — environment configuration
# Copy to .env.local for development. Add the same keys in Vercel → Settings →
# Environment Variables for production. None are required to build or deploy;
# without them, leads are logged server-side instead of emailed.
# ============================================================================

# --- Lead capture (pick ONE path) ---------------------------------------------

# Simplest: Formspree. Create a form at https://formspree.io and paste its ID
# (the part after /f/). Optional: /api/audit forwards a copy here server-side;
# it no longer bypasses Supabase/scoring. Or use FORMSPREE_FORWARD_ID instead.
# NEXT_PUBLIC_FORMSPREE_ID=xxxxxxxx

# Or: server-side email via Resend (used by /api/audit when Formspree is unset).
# Get a key at https://resend.com
# RESEND_API_KEY=re_xxx
# LEAD_TO_EMAIL=power@timetopower.ai
# LEAD_FROM_EMAIL=Time to Power <onboarding@resend.dev>

# --- Optional analytics -------------------------------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=timetopower.ai

# --- Lead persistence: Supabase (optional) ------------------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then add these. /api/audit writes leads with the service-role key
# (server-only — never expose it client-side / never prefix NEXT_PUBLIC_).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Rate limits on the paths that spend a shared provider credential (REQUIRED in production) ---
# The engine (GRIDFORGE_API_KEY) and Anthropic (ANTHROPIC_API_KEY) are paid for centrally, so every public path that reaches
# them is limited per caller and against a shared ceiling (lib/rate-limit.ts). It counts in the database, so it needs
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY AND migration 0024_rate_limit.sql applied to that database; until then the guarded
# routes answer 503 rather than run unmetered.
# The caller's address must come from a header YOUR infrastructure writes. On Vercel (VERCEL=1) the platform header
# x-forwarded-for is used (Vercel overwrites it with the connecting address) with nothing to set; if you put a CDN or proxy
# in front of Vercel the address becomes the proxy's, so declare the header that proxy sets instead. Anywhere else, name the header your proxy sets (it must overwrite or
# append, never pass a client's value through); with none declared a production build refuses to identify callers.
# GRIDFORGE_TRUSTED_IP_HEADER=fly-client-ip
# Pseudonymises callers in the counter (an HMAC key; the address is never stored). 32+ random characters. If unset it is
# derived from SUPABASE_SERVICE_ROLE_KEY, so rotating that credential would silently reset every caller's allowance.
# Rotating this one does the same, once, and nothing needs migrating.
# RATE_LIMIT_HMAC_KEY=

# --- Intelligence seats (optional) ---------------------------------------------
# Key from which the secret in a team-invitation link is derived (HMAC; the database keeps only the SHA-256 of the secret).
# 32+ random characters. If unset it is derived from SUPABASE_SERVICE_ROLE_KEY, so rotating that credential, or setting or
# changing this one, stops the invitation links that are open at that moment: the owner revokes and invites again. Members
# already seated are unaffected.
# INTELLIGENCE_INVITE_SECRET=

# --- Hot-lead notification (optional) -----------------------------------------
# Slack incoming webhook — pinged ONLY for hot-tier leads, so the channel stays
# signal. https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- Founder admin dashboard (/admin) -----------------------------------------
# Password gate for the internal lead pipeline at /admin. Required to view leads.
# Reads use SUPABASE_SERVICE_ROLE_KEY above. Pick a long random string.
# ADMIN_PASSWORD=change-me-to-something-long

# --- Founder admin dashboard (/admin) -----------------------------------------
# Password gate for the internal lead pipeline at /admin. Required to view leads.
# Reads use SUPABASE_SERVICE_ROLE_KEY above. Pick a long random string.
# ADMIN_PASSWORD=change-me-to-something-long

# --- Capacity engine (gridforge) --------------------------------------------
# The Python envelope engine that backs /qualify and the paid deliverables.
# Run it with:  python3 -m gridforge serve --port 8080
# or:           docker build -t gridforge . && docker run -p 8080:8080 gridforge
# Without GRIDFORGE_API_URL the qualifier captures the enquiry and says plainly
# that no result was produced — it never invents a number.
# GRIDFORGE_API_URL=https://engine.internal.example.com
# Only needed for the paid endpoints (/v1/screen, /v1/study, /v1/portfolio).
# Set the same value as GRIDFORGE_API_KEYS on the engine.
# GRIDFORGE_API_KEY=
# SITE_URL is used to build the intake link emailed after a purchase.
# SITE_URL=https://timetopower.ai
# Weekly Hall Watch re-runs (Vercel Cron sends this as a Bearer token).
# CRON_SECRET=   (REQUIRED for the scheduled notification retry: /api/cron/notifications fails closed without it)

# --- Payments and delivery — REQUIRED to sell (all server-side, never NEXT_PUBLIC_) -------
# Without STRIPE_SECRET_KEY checkout cannot start; without STRIPE_WEBHOOK_SECRET the webhook
# refuses every event (a signed event is the only thing that grants anything). Without
# SUPABASE_* above a paid purchase cannot be recorded and the webhook answers 500 so Stripe
# retries. Without RESEND_API_KEY + RESEND_FROM the welcome / intake / portal emails are not
# sent; the buyer's landing page (/commissioned) shows the link anyway, but the email is the
# only copy they keep, so set both in production.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# RESEND_FROM=Time to Power <power@timetopower.ai>
# Sender policy (lib/mail.ts, used by every message): RESEND_FROM, else LEAD_FROM_EMAIL. Either is enough;
# with neither, the customer-access email WAITS in the outbox (migration 0021) and the operator is told; nothing is
# lost and nothing is logged with a link. Without migration 0021 a failed first send is NOT recoverable.
# API keys are signed with this; the SAME value must be set on the engine. Without it no key
# can be minted (the portal answers 503) and the engine accepts none.
# GRIDFORGE_KEY_SECRET=

# --- Revoking a leaked API key immediately ------------------------------------
# Keys verify offline and expire on their own, which handles a lapsed
# subscription. A LEAKED key cannot wait for expiry, and the only lever used to be
# GRIDFORGE_REVOKED_KEYS — an environment variable, so a redeploy.
#
# Set BOTH of these, to the same value, on the site and on the engine. The Stripe
# webhook then pushes the revocation at cancellation and the engine refuses the key
# immediately. Verification stays offline; the engine keeps its own local list.
# Leave unset and nothing changes: keys still die at expiry as they always did.
# GRIDFORGE_ADMIN_KEY=            # separate from GRIDFORGE_API_KEYS, on purpose
# GRIDFORGE_REVOKED_FILE=/data/revoked.json   # a writable path on the engine volume
# GRIDFORGE_LEDGER_FILE=/data/ledger.jsonl    # append-only usage ledger; pay-as-you-go/free keys get a 503 without it
