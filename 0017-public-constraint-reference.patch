+          <p className="mt-3 text-mute">{c.misconception}</p>
+        </section>
+      ) : null}
+
+      {c.sources.length ? (
+        <section className="mt-8">
+          <h2 className="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
+            Basis
+          </h2>
+          <ul className="mt-2 space-y-1 text-sm text-mute">
+            {c.sources.map((s) => (
