+def write_csv_bundle(directory, intake: Intake, results: list[ScenarioResult]) -> list:
+    from pathlib import Path
+    d = Path(directory)
+    d.mkdir(parents=True, exist_ok=True)
+    written = []
+    for name, text in csv_bundle(intake, results).items():
+        p = d / name
+        p.write_text(text)
+        written.append(p)
+    return written
