@@ -0,0 +1,60 @@
+name: gridforge
+
+# The engine is what gets sold. If it cannot produce a Density Screen from the
+# blank intake that `gridforge init` hands a client, nothing else matters.
+on:
+  push:
+    branches: [main]
+    paths: ['gridforge/**', 'tests/**', 'examples/**', 'Makefile', 'pyproject.toml',
+            '.github/workflows/gridforge.yml']
+  pull_request:
+    paths: ['gridforge/**', 'tests/**', 'examples/**', 'Makefile', 'pyproject.toml']
+  workflow_dispatch:
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        python-version: ['3.11', '3.13']
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+      - name: Install test dependency only
+        run: python -m pip install --quiet pytest
+      - name: Unit and architecture tests
+        run: python -m pytest tests -q
+      - name: The engine must import with no third-party package present
+        run: python -c "import gridforge.cli, gridforge.intake.loader, gridforge.envelope"
+
+  deliverables:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.13'
+      - name: Blank intake must survive every command
+        run: |
+          python -m gridforge init -o /tmp/blank.json
+          python -m gridforge gaps /tmp/blank.json
+          python -m gridforge screen /tmp/blank.json -o /tmp/blank_out
+          python -m gridforge study  /tmp/blank.json -o /tmp/blank_out
+      - name: Every shipped example must produce a screen and a study
+        run: |
+          for f in examples/intake/*.json; do
+            python -m gridforge screen "$f" -o "/tmp/out/$(basename "$f" .json)"
+            python -m gridforge study  "$f" -o "/tmp/out/$(basename "$f" .json)"
+          done
+      - name: Portfolio screen over every example
+        run: python -m gridforge portfolio examples/intake/*.json -o /tmp/portfolio
+      - name: Reference project
+        run: python -m examples.reference_site
+      - uses: actions/upload-artifact@v4
+        with:
+          name: sample-deliverables
+          path: |
+            /tmp/portfolio
+            /tmp/blank_out
