+#
+#   fly launch --no-deploy --copy-config
+#   fly secrets set GRIDFORGE_API_KEYS=$(openssl rand -hex 24)
+#   fly deploy
+#
+# Then on the website: GRIDFORGE_API_URL=https://<app>.fly.dev and, only if the
