+# closed, not serve the deliverable for free.
+services:
+  - type: web
+    name: gridforge-engine
+    runtime: docker
+    dockerfilePath: ./Dockerfile
+    region: frankfurt
+    plan: starter
+    healthCheckPath: /health
+    envVars:
+      - key: GRIDFORGE_RATE_LIMIT
+        value: "60"
+      - key: GRIDFORGE_ALLOWED_ORIGINS
+        value: "*"
+      - key: GRIDFORGE_API_KEYS
