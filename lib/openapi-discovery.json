              "type": "string"
            }
          }
        },
        "auth_configured": {
          "type": "boolean"
        },
        "signed_keys": {
          "type": "boolean"
        },
        "rate_limit_per_minute": {
          "type": "integer"
        },
        "schema": {
          "type": "string"
        },
        "idempotency": {
          "type": "string"
        },
        "idempotency_key_max_chars": {
          "type": "integer"
        },
        "tier": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Behaviour a route has that its path does not show, as named flags. A flag is present and true only when the engine does it; an engine that does not list a flag does not do it. qualify_assumed_fields: POST /v1/qualify accepts an optional assumed_fields, a list of the seven field names it takes (contracted_MW, current_site_peak_MW, current_it_load_MW, busway_ampacity_A, tapoff_max_A, plant_supply_C, positions_available), each at most once and each one the request gives; a named figure is classed E0 (assumed), never E5, in the result's basis; the class cannot be chosen by the caller and a request without the field is answered exactly as before. The response then adds inputs_declared_assumed (what the engine recorded for each figure) and intake.assumed_count; completeness and required_inputs_missing still count a declared figure as supplied."
        },
        "unit_rates": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Units per call by route; a route with weight 0 is free."
        },
        "payg": {
          "type": "object",
          "properties": {
            "unit_price_cents": {
              "type": "integer"
            },
            "currency": {
              "type": "string"
            },
            "min_invoice_cents": {
              "type": "integer"
            },
            "free_allowance_units": {
              "type": "integer"
            },
            "billing_rule": {
              "type": "string"
            }
          },
          "description": "The pay-as-you-go terms: the engine's own statement, the only place this contract's prices live."
        },
        "metering": {
          "type": "object",
          "properties": {
            "durable": {
              "type": "boolean"
            },
            "ledger_durable": {
              "type": "boolean",
              "description": "True when a charge is recorded in a durable ledger; an Idempotency-Key survives eviction and restarts only then."
            },
            "over_quota_status": {
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "machine_interface": {
          "type": "object",
          "properties": {
            "tools": {
