{
  "note": "The engine's free discovery responses, as property lists: `required` keys are always present, the rest are optional. The OpenAPI document (lib/openapi.ts) uses these as its response schemas, and tests/test_openapi_parity.py validates every REAL response against them, so a key added, renamed or dropped on the engine without this file changing fails a test. Nothing here states a price: the figures an engine returns are values, not documentation.",
  "routes": {
    "/health": {
      "required": [
        "ok",
        "service",
        "version",
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "The engine's API schema id, added to every JSON object response."
        },
        "ok": {
          "type": "boolean"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "/v1/version": {
      "required": [
        "version",
        "provenance",
        "auth_configured",
        "signed_keys",
        "rate_limit_per_minute",
