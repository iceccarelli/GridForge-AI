#!/usr/bin/env bash
# nb — the only script you run in this repository.
#
#   ./nb rescue          from ANY state to "one branch, tests green, pushed"
#   ./nb doctor          what state is this repo in
#   ./nb normalise       show what stands between here and "one branch, no tags"
#   ./nb normalise --yes actually delete it, remote included
#   ./nb rebuild         rebuild main from the patch files, as real commits
#   ./nb apply <patch>   apply a patch, test it, refuse to keep it if tests fail
#   ./nb verify          install, test, lint, type-check
#   ./nb ship            push main
#
# DO NOT run `git checkout -- nb` after dropping a new copy in. That restores the
# version recorded on whatever branch you are standing on, which is how a fresh
# script gets replaced by an old one seconds after being uploaded — and then the
# old one fails in ways the new one was written to prevent. If you want the
# committed copy back, say so explicitly: `git checkout main -- nb`.
#
# Every command is idempotent and refuses rather than guesses. Nothing here
# creates a branch or a tag, because a single-writer repository with a
# hash-chained history in it does not need either.

set -Eeuo pipefail

# The repository this script is sitting in, not a path typed in months ago.
#
# It used to be ROOT="${ROOT:-/workspaces/neuralbridge}". A tool that assumes its
# own location will eventually be run somewhere else, and this one was: it was
# uploaded into a different repository, committed to that repository's public
# main, and then refused to run with "not a directory" — which says nothing about
# what actually happened. Deriving it means the script works wherever it is put
# and the guard below catches wherever it should not have been put.
_self_dir() { cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd; }
ROOT="${ROOT:-$(git -C "$(_self_dir)" rev-parse --show-toplevel 2>/dev/null || _self_dir)}"
MAIN="main"
# Bumped whenever this file changes. Printed by every command, so a stale copy is
# visible in the first line of output instead of in a confusing failure later.
NB_VERSION="2026.09.14.3"
# Branches that are published artefacts rather than somebody's work. gh-pages is
# rewritten by `mkdocs gh-deploy --force` in CI on every push to main: deleting
# it takes the docs site down until the next push and then it comes straight
# back, so "one branch" has never meant this one.
PROTECTED="gh-pages"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s  ok  %s%s\n' "$c_grn" "$*" "$c_off"; }
warn() { printf '%s  !!  %s%s\n' "$c_yel" "$*" "$c_off"; }
die()  { printf '%s  XX  %s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }
head_() { printf '\n%s== %s%s\n' "$c_dim" "$*" "$c_off"; }

# Three commands used to fail with three different messages for one root cause:
# the tree is not on main, or it is dirty. Whoever hit it was told "a branch named
# main already exists", then "tracked files are modified", then "not on main", and
# had to work out that those were one problem. They get one sentence now, and the
# command that fixes it.
_blocked() {
  local branch dirty
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
  dirty=$(git status --porcelain --untracked-files=no | wc -l | tr -d ' ')
  printf '%s  XX  %s%s\n' "$c_red" "$1" "$c_off" >&2
  printf '      on branch %s, %s tracked file(s) modified\n' "$branch" "$dirty" >&2
  printf '      everything that is committed is recoverable. Run:  ./nb rescue\n' >&2
  exit 1
}

cd "$ROOT" 2>/dev/null || die "not a directory: $ROOT"
git rev-parse --git-dir >/dev/null 2>&1 || die "$ROOT is not a git repository"

# This script rebuilds ONE repository from ONE patch chain. Run anywhere else it
# would reset a branch it does not understand and replay patches that do not
# belong. Refusing is cheap; the alternative is a stranger's main branch.
_wrong_repo() {
  printf '%s  XX  this is not the repository %s belongs to%s\n' \
    "$c_red" "$(basename "${BASH_SOURCE[0]}")" "$c_off" >&2
  printf '      here:   %s\n' "$ROOT" >&2
  printf '      remote: %s\n' "$(git remote get-url origin 2>/dev/null || echo '(none)')" >&2
  printf '\n      It rebuilds neuralbridge from the patch chain in that repository.\n' >&2
  printf '      Open the neuralbridge workspace and run it there.\n' >&2
  printf '\n      If it was committed here by mistake, it does not belong in the\n' >&2
  printf '      history of this project:\n\n' >&2
  printf '          git rm --cached %s && git commit -m "remove %s: it belongs to another repository"\n\n' \
    "$(basename "${BASH_SOURCE[0]}")" "$(basename "${BASH_SOURCE[0]}")" >&2
  exit 1
}

# Two independent signals, because either one alone has a false positive: a fork
# has a different remote, and a fresh clone before the first rebuild has no chain.
_looks_like_home() {
  git remote get-url origin 2>/dev/null | grep -qi 'neuralbridge' && return 0
  [ -f 0002-baseline-patches-001-and-002.patch ] && return 0
  [ -d src/assurance ] && return 0
  return 1
}
_looks_like_home || _wrong_repo

# ---------------------------------------------------------------- doctor ----
cmd_doctor() {
  head_ "identity"
  say "  repo    $(git rev-parse --show-toplevel)"
  say "  remote  $(git remote get-url origin 2>/dev/null || echo '(none)')"
  say "  branch  $(git rev-parse --abbrev-ref HEAD)"
  say "  head    $(git log --oneline -1)"

  head_ "branches"
  local locals remotes
  locals=$(git for-each-ref --format='%(refname:short)' refs/heads/ || true)
  remotes=$(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ | sed 's|^origin/||' | grep -vx -e HEAD -e origin || true)
  local working
  working=$(printf '%s\n' "$remotes" | grep -vx $(printf -- '-e %s ' $PROTECTED) || true)
  say "  local   ${locals//$'\n'/ }"
  say "  remote  ${remotes//$'\n'/ }"
  for x in $PROTECTED; do
    printf '%s\n' "$remotes" | grep -qx "$x" && say "          ($x is published by CI, not a working branch)"
  done

  head_ "tags"
  local n_local n_remote
  n_local=$(git tag -l | awk 'END{print NR+0}')
  n_remote=$( { git ls-remote --tags origin 2>/dev/null || true; } | awk '!/\^\{\}/{n++} END{print n+0}')
  say "  local $n_local   remote $n_remote"

  head_ "working tree"
  if [ -z "$(git status --porcelain)" ]; then ok "clean"; else
    git status --short | sed 's/^/  /'
  fi

  head_ "this script"
  say "  running $NB_VERSION"
  if git ls-files --error-unmatch -- "$(basename "$0")" >/dev/null 2>&1 \
     && ! git diff --quiet -- "$(basename "$0")" 2>/dev/null; then
    warn "the copy you are running differs from the committed one"
    say "      that is normal right after you drop a new one in — ./nb rescue commits it."
    say "      DO NOT run 'git checkout -- $(basename "$0")': that replaces the new copy"
    say "      with the old one and is how this went wrong last time."
  fi

  head_ "verdict"
  local bad=0
  [ "$(git rev-parse --abbrev-ref HEAD)" = "$MAIN" ] || { warn "not on $MAIN"; bad=1; }
  [ "$(printf '%s\n' "$locals" | wc -l)" -eq 1 ] || { warn "more than one local branch"; bad=1; }
  if [ "$n_local" -ne 0 ] || [ "$n_remote" -ne 0 ]; then warn "tags exist"; bad=1; fi
  if [ "$bad" -eq 0 ]; then ok "one branch, no tags, on $MAIN"; else say "  run: ./nb normalise"; fi
}

# ------------------------------------------------------------- normalise ----
cmd_normalise() {
  local commit=0 discard=0 a
  for a in "$@"; do
    case "$a" in
      --yes) commit=1 ;;
      --discard-unmerged) discard=1 ;;
      "") ;;
      *) die "unknown option: $a" ;;
    esac
  done

  _sync_self

  # Tracked modifications only. Untracked files do not stop a branch or a tag
  # from being deleted, and refusing because of them sends you off to stash
  # things that were never in the repository.
  [ -z "$(git status --porcelain --untracked-files=no)" ] \
    || _blocked "normalise needs a clean tree."

  head_ "fetching"
  git fetch origin --prune --prune-tags --tags
  if [ "$(git rev-parse --abbrev-ref HEAD)" != "$MAIN" ]; then
    git checkout "$MAIN" 2>/dev/null \
      || die "cannot switch to $MAIN from $(git rev-parse --abbrev-ref HEAD). Run ./nb rebuild."
  fi
  git pull --ff-only origin "$MAIN"

  local tags_local tags_remote br_local br_remote
  tags_local=$(git tag -l || true)
  tags_remote=$( { git ls-remote --tags origin 2>/dev/null || true; } | awk '{print $2}' | grep -v '\^{}' | sed 's|refs/tags/||' || true)
  br_local=$(git for-each-ref --format='%(refname:short)' refs/heads/ | grep -vx "$MAIN" || true)
  br_remote=$(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ | sed 's|^origin/||' | grep -vx -e "$MAIN" -e HEAD -e origin || true)
  local kept=""
  for x in $PROTECTED; do
    if printf '%s\n' $br_remote | grep -qx "$x"; then
      kept="$kept $x"
      br_remote=$(printf '%s\n' $br_remote | grep -vx "$x" || true)
    fi
  done

  [ -n "$kept" ] && { head_ "left alone"; for x in $kept; do
      say "  branch (REMOTE) $x   — published by CI, not a working branch"; done; }

  head_ "what is in the way"
  [ -n "$tags_local"  ] && printf '  tag    (local)  %s\n' $tags_local
  [ -n "$tags_remote" ] && printf '  tag    (REMOTE) %s\n' $tags_remote
  [ -n "$br_local"    ] && printf '  branch (local)  %s\n' $br_local
  [ -n "$br_remote"   ] && printf '  branch (REMOTE) %s\n' $br_remote
  if [ -z "$tags_local$tags_remote$br_local$br_remote" ]; then
    ok "already one branch, no tags"; cmd_lock; return 0
  fi

  if [ "$commit" -eq 0 ]; then
    say ""
    say "  Nothing was deleted. Local deletions are recoverable from the remote;"
    say "  remote deletions are not. When you have read the list above:"
    say ""
    say "      ./nb normalise --yes"
    return 0
  fi

  if [ "$discard" -eq 0 ]; then
    _refuse_to_lose_work
  else
    local u; u=$(_unreachable_branches)
    [ -n "$u" ] && warn "discarding unmerged commits on:${u//:/ — } (you asked)"
  fi

  head_ "deleting"
  local x failed=0
  for x in $tags_local; do
    git tag -d "$x" >/dev/null && say "  tag    (local)  $x" || { warn "could not delete local tag $x"; failed=1; }
  done
  for x in $br_local; do
    git branch -D "$x" >/dev/null && say "  branch (local)  $x" || { warn "could not delete local branch $x"; failed=1; }
  done
  # Remote deletions need a credential. A push that fails must say so: a silent
  # skip here leaves tags on the remote while the command reports success, and
  # the next fetch quietly brings them all back.
  for x in $tags_remote; do
    if git push --quiet origin ":refs/tags/$x" 2>/dev/null; then
      say "  tag    (REMOTE) $x"
    else
      warn "could not delete REMOTE tag $x — no push access to origin"; failed=1
    fi
  done
  for x in $br_remote; do
    if git push --quiet origin --delete "$x" 2>/dev/null; then
      say "  branch (REMOTE) $x"
    else
      warn "could not delete REMOTE branch $x — no push access to origin"; failed=1
    fi
  done
  [ "$failed" -eq 1 ] && warn "some deletions did not happen; the verdict below is the truth"
  git remote set-head origin "$MAIN" >/dev/null 2>&1 || true
  cmd_lock
  cmd_doctor
}

# ------------------------------------------------------- unreachable work ----
# `git branch -D` deletes a branch whether or not its commits exist anywhere else.
# On a repository whose whole point is a hash-chained history, "one branch" must
# never be reached by throwing a chain away. So before anything is deleted, every
# local branch is checked against main and the remote: if it holds commits that
# are reachable from nothing else, it is named, the deletion stops, and the way to
# keep the work is printed.
_unreachable_branches() {
  local b out=""
  for b in $(git for-each-ref --format='%(refname:short)' refs/heads/ | grep -vx "$MAIN" || true); do
    local n
    n=$(git rev-list --count "$MAIN..$b" 2>/dev/null || echo 0)
    [ "$n" -gt 0 ] && out="$out $b:$n"
  done
  printf '%s' "${out# }"
}

_refuse_to_lose_work() {
  local unreachable
  unreachable=$(_unreachable_branches)
  [ -z "$unreachable" ] && return 0
  head_ "work that exists only on another branch"
  local pair b n
  for pair in $unreachable; do
    b=${pair%:*}; n=${pair##*:}
    say "  $b — $n commit(s) not reachable from $MAIN:"
    git log --oneline "$MAIN..$b" | sed 's/^/      /'
  done
  say ""
  die "nothing was deleted. Those commits exist on no other ref, and deleting the
      branch would be the last copy going. Either fold them in:

          git checkout $MAIN && git cherry-pick <sha>...

      or, if they are superseded by the patch chain and you have read the list
      above, say so explicitly:

          ./nb normalise --yes --discard-unmerged"
}

cmd_lock() {
  head_ "locking the shape in"
  git config branch.autoSetupMerge false   # a fetch never invents a local branch
  git config push.default current          # push goes to the branch you are on, only
  git config push.followTags false         # a push never carries a tag along
  git config pull.ff only                  # a pull never writes a merge commit
  git config advice.detachedHead true
  git config fetch.prune true
  git config fetch.pruneTags true
  ok "git will not create a branch or push a tag behind your back"
}

# ------------------------------------------------------------ self-sync ----
# This script is tracked, and a newer copy gets dropped in by hand constantly.
# Left uncommitted it counts as "tracked files are modified" and blocks every
# other command, which is a trap with no upside: commit it and move on.
_sync_self() {
  local me
  me=$(basename "$0")
  git ls-files --error-unmatch -- "$me" >/dev/null 2>&1 || return 0
  git diff --quiet -- "$me" && return 0
  git add -- "$me"
  git commit -q -m "$me: refresh the repository script" -- "$me"
  ok "committed the newer $me you dropped in"
}

# A mail Subject wraps. `Subject: [PATCH] Sell what was built: README, a cold-start
# CI job, and no` continues on the next line, indented — RFC 822 folding — and git
# unfolds it back into one commit subject. Reading only the first line truncates
# every long subject, so nothing ever matched and the "already applied" check
# reported "not yet" on a repository that was entirely up to date.
_patch_subject() {
  awk '
    /^Subject: / { sub(/^Subject: (\[[^]]*\] )?/, ""); s=$0; folding=1; next }
    folding && /^[ \t]/ { sub(/^[ \t]+/, " "); s=s $0; next }
    folding { exit }
    END { if (s != "") print s }
  ' "$1"
}

# --------------------------------------------------------------- rebuild ----
# The situation this exists for: the patches were applied to the working tree
# but never committed, so every line of work shows as untracked and the
# repository's history records none of it. Committing that as one lump would
# throw away the only thing that makes the history worth having — the ability
# to see, and revert, one change at a time.
#
# So it is rebuilt from the patch files, which are themselves in the repository.
# 0001 and 0002 are folded into 0002-baseline-*.patch; the chain starts there.
cmd_rebuild() {
  local chain=() p
  [ -f 0002-baseline-patches-001-and-002.patch ] \
    || die "0002-baseline-patches-001-and-002.patch is not here. The chain starts with it."
  chain+=(0002-baseline-patches-001-and-002.patch)
  for p in $(ls 00[0-9][0-9]-*.patch 2>/dev/null | sort); do
    case "$p" in 0001-*|0002-baseline-*) continue ;; esac
    chain+=("$p")
  done
  [ "${#chain[@]}" -gt 1 ] || die "found no patches after the baseline."

  head_ "the chain"
  for p in "${chain[@]}"; do say "  $p"; done

  local backup="../$(basename "$ROOT")-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  head_ "backing the working tree up first"
  tar czf "$backup" --exclude=node_modules --exclude=.git --exclude=.next . 2>/dev/null || true
  ok "$(cd .. && pwd)/$(basename "$backup")  — delete it when you are happy"

  # This script is tracked, so `git reset --hard` would replace the copy that is
  # running with whatever version the remote has — silently downgrading the tool
  # in the middle of its own job. Keep the running copy and put it back.
  local self_copy
  self_copy=$(mktemp)
  cp "$0" "$self_copy"

  head_ "resetting $MAIN to origin/$MAIN"
  git fetch origin --prune
  # -B creates the branch or moves it; -f discards local modifications, which is
  # what rebuild is for and why the tarball above exists. The previous version
  # tried `checkout || checkout -b` and died on "a branch named main already
  # exists" whenever the tree was dirty — two failures wearing one message.
  git checkout -f -B "$MAIN" "origin/$MAIN"
  if ! cmp -s "$self_copy" "$0"; then
    cp "$self_copy" "$0"
    chmod +x "$0"
    say "  kept the newer $(basename "$0") you are running, not the one on the remote"
  fi
  rm -f "$self_copy"
  # Never clean away a patch file or this script. A patch you uploaded ten
  # seconds ago is untracked by definition, and deleting the input to the very
  # command you are running is the kind of helpfulness that loses work.
  git clean -fd -e node_modules -e .next -e '*.patch' -e nb >/dev/null
  ok "$(git log --oneline -1)"

  head_ "ignoring generated files"
  cmd_ignore

  # Is the chain already here? After a successful rescue the remote HOLDS the
  # applied chain, and replaying it onto itself conflicts on every hunk. The old
  # behaviour was to fail with a tarball message on a perfectly healthy
  # repository, which teaches you to distrust the one command meant to be safe to
  # run twice.
  head_ "is the chain already on origin/$MAIN"
  local subjects present=1 subj
  subjects=$(git log --format='%s' "origin/$MAIN" 2>/dev/null || true)
  for p in "${chain[@]}"; do
    subj=$(_patch_subject "$p")
    [ -n "$subj" ] || { present=0; say "  cannot read a subject from $p"; break; }
    printf '%s\n' "$subjects" | grep -qxF "$subj" \
      || { present=0; say "  missing: $subj"; break; }
  done
  if [ "$present" -eq 1 ]; then
    ok "every patch in the chain is already in origin/$MAIN — nothing to replay"
    cmd_verify || die "the tree does not verify. Nothing was pushed."
    say ""
    ok "already rebuilt. Now: ./nb normalise --yes   then: ./nb ship"
    return 0
  fi
  say "  not yet — replaying it"

  head_ "applying"
  git am --abort >/dev/null 2>&1 || true
  for p in "${chain[@]}"; do
    if git am --3way --whitespace=nowarn "$p" >/dev/null 2>&1; then
      say "  applied  $p"
    else
      git am --abort || true
      die "$p did not apply. $MAIN is at $(git log --oneline -1). Your tree is in $backup."
    fi
  done
  ok "$(git rev-list --count "origin/$MAIN..$MAIN") commit(s) on top of origin/$MAIN"

  cmd_verify || die "the rebuilt tree does not verify. Nothing was pushed."
  say ""
  ok "rebuilt. Now: ./nb normalise --yes   then: ./nb ship"
  return 0
}

cmd_ignore() {
  local added=0 rule
  for rule in "node_modules/" ".next/" "next-env.d.ts" "demo/" "out/" ".fly.dev" \
              "*.patch.rej" "*.orig" "attestations/" "evidence.db"; do
    grep -qxF "$rule" .gitignore 2>/dev/null && continue
    printf '%s\n' "$rule" >> .gitignore
    say "  + $rule"
    added=1
  done
  # If the running script is newer than the committed one, commit it here too —
  # otherwise the next reset drags it backwards again.
  local also=""
  if ! git diff --quiet -- "$(basename "$0")" 2>/dev/null; then
    git add -- "$(basename "$0")"
    also=" and the repository script"
    added=1
    say "  + $(basename "$0")  (newer than the committed copy)"
  fi

  if [ "$added" -eq 1 ]; then
    git add .gitignore
    git commit -q -m "gitignore: keep build output and generated evidence out of the tree${also:+, refresh nb}

A generated ledger, a rendered report and a node_modules tree are outputs, not
sources. Committing them makes every diff unreadable and puts a customer's
evidence database into a public repository by accident."
    ok "committed"
  else
    ok "already complete"
  fi
}

# ----------------------------------------------------------------- apply ----
cmd_apply() {
  local patch="${1:-}"
  [ -n "$patch" ] || die "usage: ./nb apply 00NN-something.patch"
  [ -f "$patch" ] || die "no such patch: $patch"
  [ "$(git rev-parse --abbrev-ref HEAD)" = "$MAIN" ] || _blocked "apply only runs on $MAIN."
  [ -z "$(git status --porcelain --untracked-files=no)" ] \
    || _blocked "apply needs a clean tree."

  local before; before=$(git rev-parse HEAD)
  head_ "applying $(basename "$patch")"
  git am --abort >/dev/null 2>&1 || true
  if ! git am --3way --whitespace=nowarn "$patch"; then
    git am --abort || true
    die "patch did not apply. HEAD is untouched at ${before:0:8}."
  fi
  ok "applied — $(git log --oneline -1)"

  if ! cmd_verify; then
    warn "verification failed; rolling back to ${before:0:8}"
    git reset --hard "$before"
    die "patch reverted. Nothing was kept. Do not claim success if tests fail."
  fi
  ok "kept. Push with: ./nb ship"
}

# ---------------------------------------------------------------- verify ----
cmd_verify() {
  head_ "install"
  python -m pip install -q -e '.[dev]' 2>&1 | grep -vE 'WARNING: Running pip|virtual environment' || true
  python -m pip install -q cryptography 2>&1 | grep -vE 'WARNING: Running pip|virtual environment' || true

  head_ "tests"
  python -m pytest tests/ -q --no-cov || return 1

  head_ "lint"
  ruff check src/assurance tests/ || return 1

  head_ "types"
  mypy src/assurance 2>&1 | tail -5 || true

  head_ "surface"
  python -m assurance | sed 's/^/  /'
  ok "verified"
  return 0
}

# ------------------------------------------------------------------ ship ----
cmd_ship() {
  _sync_self
  [ "$(git rev-parse --abbrev-ref HEAD)" = "$MAIN" ] || _blocked "ship only pushes $MAIN."
  [ -z "$(git status --porcelain --untracked-files=no)" ] || _blocked "ship needs a clean tree."
  head_ "pushing $MAIN"
  git push --no-follow-tags origin "$MAIN"
  ok "$(git log --oneline -1)"
}

# ---------------------------------------------------------------- rescue ----
# One command from any state to "one branch, tests green, pushed".
#
# It exists because the recovery was four commands that had to be run in order,
# each of which refused for a different reason if the one before had not finished
# — and the failure that started it all was a stale copy of THIS script. A repair
# procedure you have to already be healthy to run is not a repair procedure.
cmd_rescue() {
  head_ "what this will do"
  say "  1. refuse if any local branch holds commits that exist nowhere else"
  say "  2. tar the working tree up"
  say "  3. reset $MAIN to origin/$MAIN and replay the patch chain onto it"
  say "  4. delete every other branch and tag, local and remote (gh-pages kept)"
  say "  5. install, test, lint, type-check"
  say "  6. push $MAIN"
  say ""
  say "  Untracked files that are not patches are discarded in step 3. They are in"
  say "  the tarball. Nothing that is committed anywhere is lost at any point."

  head_ "checking for work that exists only on another branch"
  _refuse_to_lose_work
  ok "every local branch is reachable from $MAIN — nothing to lose"

  cmd_rebuild
  cmd_normalise --yes
  cmd_ship

  head_ "done"
  ok "one branch, $(git rev-list --count HEAD) commit(s), pushed"
  say "  the tarball in $(cd .. && pwd) can go when you are happy."
}

printf '%snb %s%s\n' "$c_dim" "$NB_VERSION" "$c_off"
case "${1:-doctor}" in
  doctor)    cmd_doctor ;;
  normalise|normalize) shift || true; cmd_normalise "$@" ;;
  rebuild)   cmd_rebuild ;;
  ignore)    cmd_ignore ;;
  apply)     shift; cmd_apply "$@" ;;
  verify)    cmd_verify ;;
  ship)      cmd_ship ;;
  rescue)    cmd_rescue ;;
  version)   say "  $NB_VERSION" ;;
  *)         die "unknown command: $1  (rescue|doctor|normalise|rebuild|apply|verify|ship)" ;;
esac
